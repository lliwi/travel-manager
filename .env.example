# =====================================================================
# Travel Manager — plantilla de configuración
#
# Copie este archivo a docker/.env y rellene los valores marcados.
# `./setup.sh` lo hace por usted y genera los secretos automáticamente.
#
# Este archivo NUNCA debe contener valores reales: está versionado.
# =====================================================================

# ---------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------
FLASK_ENV=production
FLASK_APP=wsgi.py

# Firma las cookies de sesión y los tokens CSRF. Si se filtra, cualquiera
# puede falsificar una sesión.
# Genérela con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambie-esto-por-64-caracteres-hexadecimales

# URL pública de la aplicación, usada en enlaces y redirecciones.
APP_PUBLIC_URL=http://localhost

# ---------------------------------------------------------------------
# Cifrado de secretos en reposo
# ---------------------------------------------------------------------
# Cifra las claves API de los proveedores de IA y los números de documento
# de los viajeros. Sin ella la aplicación se niega a arrancar en producción.
# Genérela con:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=cambie-esto-por-una-clave-fernet

# Durante una rotación de clave, la anterior se mantiene aquí para poder
# descifrar lo que aún no se ha vuelto a cifrar. Déjela vacía si no rota.
SECRETS_ENCRYPTION_KEY_PREVIOUS=

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_DB=travel_manager
POSTGRES_USER=travel
POSTGRES_PASSWORD=cambie-esta-contrasena

# ---------------------------------------------------------------------
# Redis (cola de trabajos, caché y limitación de tasa)
# ---------------------------------------------------------------------
REDIS_PASSWORD=cambie-esta-contrasena

# ---------------------------------------------------------------------
# Almacenamiento de documentos (MinIO, compatible con S3)
#
# Los adjuntos viven fuera de PostgreSQL: la base de datos guarda solo
# metadatos, el hash y la clave del objeto.
# ---------------------------------------------------------------------
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=cambie-esta-contrasena
S3_BUCKET_DOCUMENTS=travel-documents
S3_BUCKET_QUARANTINE=travel-quarantine

# ---------------------------------------------------------------------
# Antivirus
#
# 'clamav' usa el contenedor incluido. 'noop' desactiva el análisis: úselo
# solo si otro control escanea los archivos antes de que lleguen aquí.
# ---------------------------------------------------------------------
ANTIVIRUS_BACKEND=clamav

# ---------------------------------------------------------------------
# Inteligencia artificial
#
# Ollama se ejecuta en el host, no en Docker. Instálelo desde ollama.com y
# descargue el modelo con:  ollama pull llama3.1:8b
# Compruebe la conexión con:  docker compose exec web flask ai-health
# ---------------------------------------------------------------------
AI_DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b

# Política de salida de datos. Por defecto, el contenido de los documentos y
# los datos personales NO salen a proveedores remotos. Cambiarlo es una
# decisión expresa de la organización; también puede hacerse desde
# Administración → Ajustes sin reiniciar.
AI_ALLOW_EXTERNAL_DOCUMENTS=false
AI_ALLOW_EXTERNAL_PII=false

# ---------------------------------------------------------------------
# OCR y localización
# ---------------------------------------------------------------------
OCR_LANGUAGES=spa+eng
DEFAULT_TIMEZONE=Europe/Madrid
DEFAULT_LOCALE=es

# ---------------------------------------------------------------------
# Límites
# ---------------------------------------------------------------------
# Tamaño máximo por documento, en bytes. 33554432 = 32 MB.
MAX_DOCUMENT_BYTES=33554432
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SESSION_LIFETIME_HOURS=8

# ---------------------------------------------------------------------
# Servidor y procesos
# ---------------------------------------------------------------------
# Puerto en el que se publica la aplicación en producción (tras Nginx).
HTTP_PORT=80
HTTPS_PORT=443
GUNICORN_WORKERS=4

# Puerto de la aplicación en desarrollo (./start.sh --dev), sin Nginx.
DEV_PORT=5000
CELERY_CONCURRENCY=2
CELERY_LOG_LEVEL=info

# ---------------------------------------------------------------------
# Registro
# ---------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
